# Copy to .env.local and fill in. Never commit real values.

# Public site origin (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend REST API base URL, no trailing slash. Server-only: the browser never calls the backend.
# e.g. https://backend-w586.onrender.com/api/v1 (temporary test deployment)
API_BASE_URL=

# true: serve only the endpoints the backend lacks (see src/lib/api/GAPS.md: blog, feeds, newsletter, returns, Razorpay order/verify)
# from MSW mocks; everything else still goes to the real API. false: call the real API for everything.
NEXT_PUBLIC_USE_MOCKS=true

# Razorpay Standard Checkout: PUBLIC key id only (rzp_test_... / rzp_live_...). key_secret and webhooks live on the backend only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Social links (public). Business contact details live in src/config/site.ts
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/channel/UCxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-handle/
